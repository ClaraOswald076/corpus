# 数据库路径（默认使用 SQLite，生产环境可切换 PostgreSQL，
# 参考 config.py 中 database_url_production 的连接串格式）
DATABASE_URL=sqlite+aiosqlite:///./multi_agent.db

# 加密密钥（必须设置，用于加密存储 API Key）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# 调试模式（生产环境设为 false）
DEBUG=false

# 邮件配置（通讯科Agent发送每日简报时使用，可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
USER_EMAIL=
